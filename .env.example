# --- OpenAI ---
OPENAI_KEY=sk-...
OPENAI_MODEL=gpt-5
LLM_PROVIDER=openai
OPENAI_BASE_URL=

# --- MCP ---
PENNY_MCP_URL=http://localhost:8011/mcp/
# Pinned account scope for the preprocess/tenant-scoping layer — the model never supplies
# or sees this; there is no per-user auth/session layer yet, so a single account is used.
DEFAULT_ACCOUNT_ID=1
# Which call-type this Agent instance runs as (transaction_saving | penny | uncle_sam |
# dollar_bill) — controls which MCP tools it's allowed to see. Only "penny" is actually
# wired up in this project today.
PROCESS_CLASS=penny

# --- Agent loop ---
MAX_TOOL_ITERATIONS=12
TOOL_CALL_TIMEOUT_SECONDS=45
LOG_LEVEL=INFO

# --- Conversation cache / State manager ---
STATE_DIR=state/
MAX_HISTORY_MESSAGES=12
MAX_MESSAGE_CHARS=3000

# --- Dynamic skills & tools (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_TOOLS_COLLECTION=agent_tools
QDRANT_SKILLS_COLLECTION=agent_skills
QDRANT_EMBEDDING_MODEL=text-embedding-3-small
QDRANT_TOP_K=8
SKILLS_DIR=skills/

# --- API auth (same credentials/server as the original realbooks-agents) ---
COGNITO_JWKS_URL=
USERS_DOMAIN=
