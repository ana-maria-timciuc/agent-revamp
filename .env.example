# --- OpenAI ---
OPENAI_KEY=sk-...
OPENAI_MODEL=gpt-5
LLM_PROVIDER=openai
OPENAI_BASE_URL=

# --- MCP ---
PENNY_MCP_URL=http://localhost:8011/mcp/
# Pinned account scope for the preprocess/tenant-scoping layer — the model never supplies
# or sees this; there is no per-user auth/session layer yet, so a single account is used.
DEFAULT_ACCOUNT_ID=1
# Which call-type this Agent instance runs as (transaction_saving | penny | uncle_sam |
# dollar_bill) — controls which MCP tools it's allowed to see. Only "penny" is actually
# wired up in this project today.
PROCESS_CLASS=penny

# --- Agent loop ---
MAX_TOOL_ITERATIONS=12
TOOL_CALL_TIMEOUT_SECONDS=45
LOG_LEVEL=INFO
# Postprocess "Validation" gate (agent.py chat(), non-streaming path only): bounded
# retries when the model's answer fails the leak-safety/quality check before falling
# back to a generic message.
MAX_VALIDATION_RETRIES=2

# --- RAG / intent preprocessing ---
# Qdrant server (docker run -d --name qdrant -p 6333:6333 -p 6334:6334 \
#   -v qdrant_data:/qdrant/storage qdrant/qdrant:latest)
EMBEDDING_MODEL=text-embedding-3-small
INTENT_TAXONOMY=...
# Reranker fail->retry loop (preprocess/catalog.py): bounded retries, widening top_k by
# this multiplier each attempt, before returning a best-effort result.
RERANK_MAX_RETRIES=2
RERANK_RETRY_TOP_K_MULTIPLIER=2
# Optional override of seed skill locations: comma-separated agent_type=/path pairs.
# Defaults to the three agents under ../realbooks-agents/agents/*/skills.
SKILLS_DIRS=

# --- Conversation cache / State manager ---
STATE_DIR=state/
MAX_HISTORY_MESSAGES=12
MAX_MESSAGE_CHARS=3000

# --- Dynamic skills & tools (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_TOOLS_COLLECTION=agent_tools
QDRANT_SKILLS_COLLECTION=agent_skills
QDRANT_TOP_K=8
SKILLS_DIR=skills/

# --- API auth (same credentials/server as the original realbooks-agents) ---
COGNITO_JWKS_URL=
USERS_DOMAIN=
