# --- OpenAI ---
OPENAI_KEY=sk-...
OPENAI_MODEL=gpt-5
LLM_PROVIDER=openai
OPENAI_BASE_URL=

# --- MCP ---
PENNY_MCP_URL=http://localhost:8011/mcp/

# --- Agent loop ---
MAX_TOOL_ITERATIONS=12
LOG_LEVEL=INFO

# --- RAG / intent preprocessing ---
# Qdrant server (docker run -d --name qdrant -p 6333:6333 -p 6334:6334 \
#   -v qdrant_data:/qdrant/storage qdrant/qdrant:latest)
QDRANT_URL=http://localhost:6333
QDRANT_SKILLS_COLLECTION=skills
QDRANT_TOOLS_COLLECTION=tools
EMBEDDING_MODEL=text-embedding-3-small
INTENT_TAXONOMY=analytics, reporting, lookup, create_record, market_research, meta_about, off_domain
RETRIEVAL_TOP_K=5
# Optional override of seed skill locations: comma-separated agent_type=/path pairs.
# Defaults to the three agents under ../realbooks-agents/agents/*/skills.
SKILLS_DIRS=
